# ==========================================
# TELEGRAM BOT KONFIGURATSIYA SOZLAMALARI
# ==========================================
# Ushbu fayl nusxasini olib, '.env' nomi bilan saqlang:
# cp .env.example .env
# Va quyidagi qiymatlarni o'zingizniki bilan to'ldiring:

# Telegram BotFather'dan olingan bot tokeni:
BOT_TOKEN=BU_YERGA_BOT_TOKEN_YOZING

# Sizning Telegram profilingiz raqamli ID'si (masalan: 123456789):
ADMIN_ID=BU_YERGA_TELEGRAM_ID_YOZING

# Admin foydalanuvchi nomi (@ bilan):
SUPPORT_USERNAME=@Lukhmonjonov_10
